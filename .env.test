# ─────────────────────────────────────────────────────────────────
#  Ambiente de TESTE — usado por pytest, CI e automação.
#  NÃO usar em desenvolvimento local (.env) nem em produção.
#  Copie este arquivo como ponto de partida e ajuste o necessário.
# ─────────────────────────────────────────────────────────────────

APP_NAME=NomeDoProjeto
APP_ENV=test
# SECRET_KEY descartável — NUNCA reutilizar em prod. Gerar nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=test-secret-key-trocar-NUNCA-USAR-FORA-DE-TESTES
DEBUG=False
APP_URL=http://localhost:8001

# ─── Banco de dados (instância isolada para testes) ──────────────
# Recomendado: banco dedicado com sufixo _test para não contaminar
# o de desenvolvimento. O Django, por padrão, prefixa "test_" no
# nome quando roda `manage.py test`; aqui usamos sufixo explícito
# para deixar claro em logs e no MySQL Workbench.
DB_ENGINE=django.db.backends.mysql
DB_NAME=NomeDoBancoDeDados_test
DB_USER=root
DB_PASSWORD=SenhaDoBancoDeDados
DB_HOST=localhost
DB_PORT=3306

# ─── Email (sem envio real) ──────────────────────────────────────
# 'locmem' guarda mensagens em django.core.mail.outbox para os
# testes inspecionarem. Nada sai da máquina.
MAIL_MAILER=locmem
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="test@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Frontend (Vite) ─────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
