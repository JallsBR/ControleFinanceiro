DOMAIN=finanças.o5o.tech
APP_URL=https://finanças.o5o.tech
DEBUG=False
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=finanças.o5o.tech,xn--finanas-yxa.o5o.tech
CSRF_TRUSTED_ORIGINS=https://finanças.o5o.tech,https://xn--finanas-yxa.o5o.tech
CORS_ALLOWED_ORIGINS=https://finanças.o5o.tech,https://xn--finanas-yxa.o5o.tech

DB_NAME=controle_db
DB_USER=controle
DB_PASSWORD=troque-senha-forte
MYSQL_ROOT_PASSWORD=troque-root-forte

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=25
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# SMTP (mailserver na VPS — mail.o5o.tech)
# Em produção a API precisa estar na rede Docker externa mail-o5o_default
# (ver docker-compose.prod.yml). Sem isso, mail.o5o.tech (IP público) dá
# timeout por hairpin NAT e o signin/2FA/reset trava.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.o5o.tech
EMAIL_PORT=465
EMAIL_HOST_USER=financas@o5o.tech
EMAIL_HOST_PASSWORD=troque-senha-da-caixa
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=financas@o5o.tech
FRONTEND_URL=https://xn--finanas-yxa.o5o.tech
